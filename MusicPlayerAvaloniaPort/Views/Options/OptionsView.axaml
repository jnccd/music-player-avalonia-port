<UserControl
    x:Class="MusicPlayerAvaloniaPort.Views.Options.OptionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:MusicPlayerAvaloniaPort.Converters;assembly=MusicPlayerAvaloniaPort"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:options="using:MusicPlayerAvaloniaPort.Views.Options"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:vm="using:MusicPlayerAvaloniaPort.ViewModels"
    x:DataType="vm:OptionsViewModel">
    <UserControl.Resources>
        <conv:AddMultiplyConverter x:Key="AddMultiplyConverter" />
        <conv:EitherOrConverter x:Key="EitherOrConverter" />
    </UserControl.Resources>
    <WrapPanel Margin="5">
        <GroupBox Header="General" Margin="3">
            <StackPanel Spacing="8">
                <CheckBox Content="Low Power Mode" IsChecked="{Binding LowPowerMode, Mode=TwoWay}" />
                <TextBlock Foreground="#80FFFFFF" TextWrapping="Wrap" MaxWidth="260"
                           Text="Reduces the CPU usage of the visualizations (lower diagram frame rate and FFT analysis resolution). Handy on laptops and other battery powered devices." />
                <Label Padding="0" Content="Primary Color" Target="primaryColorHexTextBox" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="primaryColorPreview" Width="48" Height="28" VerticalAlignment="Center"
                            BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" />
                    <TextBox x:Name="primaryColorHexTextBox" Width="90" VerticalAlignment="Center"
                             TextChanged="PrimaryColorHexTextBox_TextChanged" />
                    <Button x:Name="resetPrimaryColorButton" VerticalAlignment="Center"
                            Click="ResetPrimaryColorButton_Click">Reset</Button>
                </StackPanel>
                <options:ColorPickerControl x:Name="primaryColorPicker" Width="260" />
                <TextBlock Foreground="#80FFFFFF" TextWrapping="Wrap" MaxWidth="260"
                           Text="The accent color of the progress bar, the volume bars, the visualizations and the other highlights. The color is applied immediately." />
                <CheckBox x:Name="systemAudioCaptureCheckBox" Content="Visualize System Audio"
                          IsCheckedChanged="SystemAudioCaptureCheckBox_IsCheckedChanged" />
                <TextBlock Foreground="#80FFFFFF" TextWrapping="Wrap" MaxWidth="260"
                           Text="Draws what the whole operating system outputs (every application, not just this player) in the FFT diagram instead of the currently playing song. Windows captures the default output device directly; on Linux a monitor source of the default sink is used, on macOS a loopback driver such as BlackHole has to be installed." />
                <TextBlock Name="systemAudioCaptureStateLabel" Foreground="#80FFFFFF" TextWrapping="Wrap"
                           MaxWidth="260" Text="" />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Sync Server Connection" Margin="3">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Host:" Target="hostTextBox" />
                    <TextBox x:Name="hostTextBox" MinWidth="200" Text="{Binding SyncServerHost}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Username:" Target="usernameTextBox" />
                    <TextBox x:Name="usernameTextBox" MinWidth="150" Text="{Binding SyncServerUsername}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="Password:" Target="passwordTextBox" />
                    <TextBox x:Name="passwordTextBox" MinWidth="150" PasswordChar="*" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="loginButton" Click="LoginButton_Click">Login</Button>
                    <Button x:Name="registerButton" Click="RegisterButton_Click">Register</Button>
                    <ProgressBar x:Name="loginProgressBar" Width="90" Height="12" VerticalAlignment="Center"
                                 IsIndeterminate="True" IsVisible="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="State: " />
                    <TextBlock Name="syncStateLabel" Width="200" Text="" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Download Folder" Margin="3">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Download Folder Path" Target="downloadFolderTextBox" />
                    <TextBox x:Name="downloadFolderTextBox" MinWidth="200" Text="{Binding DownloadFolderPath}" />
                    <Button Margin="4,0,0,0" Click="DownloadFolderSaveButton_Click">Save</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="State: " />
                    <TextBlock Name="downloadStateLabel" Width="350" Text="" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Foreground="#80FFFFFF" Content="C# Out: " />
                    <TextBox Name="downloadCsharpLogLabel" Foreground="#80FFFFFF" IsReadOnly="True"
                             MaxHeight="100" Width="350" Text="" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Foreground="#80FFFFFF" Content="Shell Out: " />
                    <TextBox Name="downloadShellLogLabel" Foreground="#80FFFFFF" IsReadOnly="True"
                             MaxHeight="100" Width="350" Text="" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Music Library" Margin="3">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Music Library Path" Target="musicLibraryTextBox" />
                    <TextBox x:Name="musicLibraryTextBox" MinWidth="200" Text="{Binding MusicLibraryFolderPath}" />
                    <Button Margin="4,0,0,0" Click="SelectMusicLibraryButton_Click">Select</Button>
                    <Button Margin="4,0,0,0" Click="SetMusicLibraryButton_Click">Save</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Music Library Song Count: " />
                    <TextBlock Name="musicLibraryCountLabel" Text="{Binding MusicLibrarySongCount}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Windows" Margin="3">
            <StackPanel Spacing="8">
                <TextBlock Foreground="#80FFFFFF" TextWrapping="Wrap" MaxWidth="260"
                           Text="The extra views of the player. Each one opens in its own window, so it can stay open next to the player." />
                <Button Name="statisticsWindowButton" Click="StatisticsWindowButton_Click">Statistics</Button>
                <Button Name="exportLibraryWindowButton" Click="ExportLibraryWindowButton_Click">Export Library</Button>
                <Button Name="songHistoryWindowButton" Click="SongHistoryWindowButton_Click">Song History</Button>
            </StackPanel>
        </GroupBox>
    </WrapPanel>
</UserControl>

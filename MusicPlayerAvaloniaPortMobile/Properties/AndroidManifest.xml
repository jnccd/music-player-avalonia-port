<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.jnccd.musicplayermobile"
          android:installLocation="auto">

  <!-- Talking to the sync server. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!--
    Reading the song library from shared storage. Android 13 (API 33) replaced the blanket storage
    permission with the per media type one; the old permission is still needed on anything below that
    (hence maxSdkVersion), and it is requested at runtime by MainActivity - see MobilePlatform.
  -->
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

  <!--
    The ongoing media notification (MobilePlaybackNotificationService). It is a foreground service, which is
    both what makes the notification persistent and what keeps playback alive when the app is left.
    POST_NOTIFICATIONS is requested at runtime on API 33+ - without it the service still runs, but the user
    sees no notification.
  -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

  <application android:label="Music Player"
               android:icon="@mipmap/ic_launcher"
               android:usesCleartextTraffic="true" />
</manifest>
